# Configuracao do script gerador de historias (scripts/gerar_historias.py).
# O APLICATIVO WEB NAO LE ESTE ARQUIVO e nunca chama nenhuma API: ele e 100% estatico.
# Copie para `.env` (que fica fora do git) e preencha.

# Chave da API da Anthropic, usada apenas na sua maquina para gerar historias novas.
ANTHROPIC_API_KEY=

# Modelo usado na geracao. Opcoes comuns: claude-opus-5, claude-sonnet-5.
MODELO_GERACAO=claude-sonnet-5
