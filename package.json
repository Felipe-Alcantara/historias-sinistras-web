{
  "name": "historias-sinistras-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Jogo web de enigmas investigativos resolvidos com perguntas de sim ou nao para o mestre.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
